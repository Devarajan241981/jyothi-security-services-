# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Resend (resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="JSS Website <onboarding@resend.dev>"
NOTIFY_EMAIL=info@jyothisecurityservices.in

# Sentry (optional — leave unset to disable error tracking locally)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://www.jyothisecurityservices.in
